{
  "id": null,
  "uid": "news-api-observability",
  "title": "News API Observability",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "HTTP Requests Rate (req/s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "sum(rate(http_requests_total[1m])) by (method, handler, status)",
          "legendFormat": "{{method}} {{handler}} ({{status}})"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "HTTP Request Latency p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket[5m])) by (le, handler))",
          "legendFormat": "p95 {{handler}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Created News (news_created_total)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "news_created_total",
          "legendFormat": "Created News"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Registered Users (users_registered_total)",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "users_registered_total",
          "legendFormat": "Registered Users"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "News Notifications Sent & Skipped",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "Prometheus" },
      "targets": [
        {
          "expr": "news_notifications_sent_total",
          "legendFormat": "sent ({{notification_type}})"
        },
        {
          "expr": "news_notifications_skipped_total",
          "legendFormat": "skipped ({{notification_type}})"
        },
        {
          "expr": "news_notifications_failed_total",
          "legendFormat": "failed ({{notification_type}})"
        }
      ]
    }
  ]
}
